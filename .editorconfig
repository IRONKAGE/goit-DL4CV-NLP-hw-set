# ==============================================================================
# 🛠️ EDITORCONFIG: MLOps & Data Science Enterprise Standard
# ==============================================================================
# Цей файл гарантує, що у всіх інженерів (VS Code, PyCharm, Cursor)
# будуть однакові налаштування відступів, закінчення рядків та кодувань.

# Це кореневий файл конфігурації, редакторам не потрібно шукати вище
root = true

# ------------------------------------------------------------------------------
# 🌍 БАЗОВІ ПРАВИЛА ДЛЯ ВСІХ ФАЙЛІВ (UNIX-стандарт / Docker-сумісність)
# ------------------------------------------------------------------------------
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# ------------------------------------------------------------------------------
# 🐍 PYTHON (Marimo Notebooks, ETL-ядро, FastAPI Скрипти)
# ------------------------------------------------------------------------------
[*.py]
indent_style = space
indent_size = 4
max_line_length = 119

# ------------------------------------------------------------------------------
# 🪄 MLOPS ОРКЕСТРАЦІЯ (Makefile)
# ------------------------------------------------------------------------------
# КРИТИЧНО: GNU Make сприймає лише жорсткі ТАБИ. Пробіли зламають скрипт.
[{Makefile,makefile}]
indent_style = tab
indent_size = 4
# Скасовуємо деякі обмеження для зручності написання bash-команд всередині
trim_trailing_whitespace = false
max_line_length = off

# ------------------------------------------------------------------------------
# 🐳 DOCKER ТА CI/CD (Bash-скрипти, Dockerfile)
# ------------------------------------------------------------------------------
[*.sh]
indent_style = space
indent_size = 2

[{Dockerfile,*.dockerignore}]
indent_style = space
indent_size = 4

# ------------------------------------------------------------------------------
# 💾 СИРІ ДАНІ ТА НАБОРИ ДАНИХ (ETL Pipeline)
# ------------------------------------------------------------------------------
# Забороняємо IDE чіпати сирі таблиці, щоб уникнути гігантських паразитних Git diff-ів
[*.{csv,tsv}]
trim_trailing_whitespace = false
insert_final_newline = false

# ------------------------------------------------------------------------------
# 📄 КОНФІГУРАЦІЙНІ ФАЙЛИ, СХЕМИ ТА НОУТБУКИ (JSON, YAML, TOML, IPYNB)
# ------------------------------------------------------------------------------
[*.{json,ipynb,yml,yaml,toml}]
indent_style = space
indent_size = 2

# ------------------------------------------------------------------------------
# 🌐 WEB-АРТЕФАКТИ (HTML, CSS, JS для FastAPI / Marimo)
# ------------------------------------------------------------------------------
[*.{html,css,js}]
indent_style = space
indent_size = 2

# ------------------------------------------------------------------------------
# 📖 ДОКУМЕНТАЦІЯ (Markdown, TXT)
# ------------------------------------------------------------------------------
# У Markdown два пробіли в кінці рядка створюють перенесення (hard line break),
# тому тут ми забороняємо редакторам автоматично зрізати пробіли в кінці.
[*.{md,txt}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

# ------------------------------------------------------------------------------
# 🔐 СЕКРЕТИ ТА GIT (Змінні середовища)
# ------------------------------------------------------------------------------
[{.env,*.env,.env.*,.gitignore}]
indent_style = space
indent_size = 2

# ===============================================
# 1. Секрети та Конфігурації
# ===============================================
# Ніколи не пушимо реальні API-ключі та паролі в Git
.env
.env.local
.env.*
*.pem
kaggle.json
# Дозволяємо пушити шаблон .env.example
!.env.example

# ===============================================
# 2. Дані (Data ETL Pipeline)
# ===============================================
# Ігноруємо всі сирі та оброблені дані, щоб не "розірвати" GitHub (ліміт 100MB/файл)
data/*
!data/.gitkeep
*.csv
*.tsv
*.xlsx
*.parquet
*.json
*.zip
*.tar.gz

# ===============================================
# 3. Моделі, Foundation Models та MLOps Артефакти
# ===============================================
models/*
!models/.gitkeep
# 🛡️ ДОЗВОЛЯЄМО пушити JSON-схему ознак, щоб бекенд знав API-контракт моделі!
!models/features_schema.json

# Серіалізовані моделі
*.joblib
*.pkl
*.pickle
*.pt
*.pth
*.h5
*.onnx
*.safetensors

# Звіти розвідувального аналізу (можуть важити 10+ МБ)
*.html

# Кеш завантажених ваг моделей (Hugging Face / TimesFM)
.cache/

# Трекінг MLflow
mlruns/
!mlruns/.gitkeep
*.db
*.sqlite

# ===============================================
# 4. Логи та Тимчасові файли
# ===============================================
*.log
.temp/
.tmp/

# ===============================================
# 5. Віртуальні середовища та Кеш Python
# ===============================================
# Менеджери середовищ (uv, venv, conda)
.venv/
venv/
env/
.conda/

# Кеш інтерпретатора та компілятора
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ===============================================
# 6. Операційні системи та IDE
# ===============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE (VS Code, PyCharm, Cursor)
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.swp

# ===============================================
# 7. Ноутбуки та UI (Marimo / Jupyter)
# ===============================================
.ipynb_checkpoints/
__marimo__/

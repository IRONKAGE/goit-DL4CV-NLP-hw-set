# ==============================================================================
# 🔐 ШАБЛОН НАЛАШТУВАНЬ СЕРЕДОВИЩА (ENVIRONMENT VARIABLES)
# ==============================================================================
# ІНСТРУКЦІЯ:
# 1. Зробіть копію цього файлу та назвіть її `.env`
# 2. Замініть фіктивні значення на ваші реальні ключі та шляхи
# 3. Файл `.env` ігнорується Git, тому ваші секрети залишаться у безпеці
# ==============================================================================

# ------------------------------------------------------------------------------
# 📊 KAGGLE API (Завантаження наборів даних для ДЗ)
# ------------------------------------------------------------------------------
# Отримайте ці дані у своєму профілі Kaggle -> Settings -> Create New Token
KAGGLE_USERNAME="your_kaggle_username_here"
KAGGLE_KEY="your_kaggle_secret_key_here"

# ------------------------------------------------------------------------------
# 📈 MLFLOW TRACKING (MLOps Серіалізація)
# ------------------------------------------------------------------------------
# URI для базы данных экспериментів (може бути локальним SQLite або хмарним URL)
MLFLOW_TRACKING_URI="sqlite:///mlruns/mlruns.db"
# Дефолтна назва експерименту для запобігання втрати метрик
MLFLOW_EXPERIMENT_NAME="default_goit_experiment"

# ------------------------------------------------------------------------------
# 🚀 FASTAPI MODEL SERVING (Мікросервіс)
# ------------------------------------------------------------------------------
# Хост та порт для локального сервера або Docker-контейнера
API_HOST="0.0.0.0"
API_PORT=8000
# Секретний ключ для захисту POST-запитів до вашої моделі (JWT / Bearer)
API_SECRET_KEY="super_secret_dev_key_change_in_production"

# ------------------------------------------------------------------------------
# ⚙️ CORE INFRASTRUCTURE (Глобальні налаштування)
# ------------------------------------------------------------------------------
# Залиште порожнім (Auto) для автоматичного пошуку найкращої відеокарти (CUDA/MPS/XPU)
# Вкажіть 'cpu', якщо хочете примусово вимкнути GPU (наприклад, у Docker або CI/CD)
ML_BACKEND=
# Глобальний Seed для забезпечення відтворюваності експериментів (PyTorch, Sklearn)
GLOBAL_SEED=42
# Системні шляхи (використовуються модулем etl_core.py)
DATA_DIR="./data"
MODELS_DIR="./models"

# 🍎 macOS HARDWARE ACCELERATION (MPS)
# Станом на 2026 рік Apple Silicon (M-серія) підтримує Metal API повноцінно!
# Цей прапорець є рятувальним колом для legacy-систем (Intel + AMD Radeon),
# дозволяючи PyTorch тихо перекидати на CPU ті операції,
# які більше не отримують оновлень Metal від Apple для AMD-архітектури
PYTORCH_ENABLE_MPS_FALLBACK=1
